{
 "506cd868fbb4586b": {
  "text": "수학 일 학년 이 학기, 백까지의 수! 단원 개념을 함께 정리해 볼까요?",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "f82375a2f6c03f74": {
  "text": "세어 볼까요?",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "b86dae5403aa98d8": {
  "text": "십!",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "de9be09bb67ace81": {
  "text": "이십!",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "dbe33f7b38eefadd": {
  "text": "삼십!",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "67d3929f2e09ab48": {
  "text": "사십!",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "02d6c57914f1d826": {
  "text": "오십!",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "6412ec1acf0e1adf": {
  "text": "육십!",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "1062d2f371806a55": {
  "text": "열 개씩 묶음 여섯 개를 육십이라고 해요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "689451ca0e36998b": {
  "text": "육십은 육십 또는 예순이라고 읽어요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "e5ce4699b609ce1e": {
  "text": "열 개씩 묶음 일곱 개는 칠십, 칠십 또는 일흔이에요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "2ad03a5646094259": {
  "text": "열 개씩 묶음 여덟 개는 팔십, 팔십 또는 여든이에요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "48865d1c185789ca": {
  "text": "열 개씩 묶음 아홉 개는 구십, 구십 또는 아흔이에요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "307c4b78f13968e3": {
  "text": "열 개씩 묶음 일곱 개와 낱개 세 개가 있어요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "4986a23dc1fc838f": {
  "text": "이것을 칠십삼이라고 해요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "409b65c17729e6ad": {
  "text": "칠십삼은 칠십삼 또는 일흔셋이라고 읽어요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "e6b3607851332e71": {
  "text": "구십보다 일만큼 더 작은 수는 팔십구예요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "296526ec9061acb7": {
  "text": "구십보다 일만큼 더 큰 수는 구십일이에요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "afd5747a824ec853": {
  "text": "오십일부터 백까지, 수의 순서를 알아볼까요?",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "7d95678f36db5f98": {
  "text": "오른쪽으로 한 칸 갈 때마다 일씩 커져요!",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "a28ce0508b7834a5": {
  "text": "구십구보다 일만큼 더 큰 수는 얼마일까요?",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "93791899baa7fbfd": {
  "text": "낱개 열 개는 열 개씩 묶음 한 개! 그래서 백이에요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "ec84645a719b0b18": {
  "text": "백은 백이라고 읽어요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "734f5d0e0a977858": {
  "text": "오십육과 육십이, 어느 수가 더 클까요?",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "cc1241a7300e4dc6": {
  "text": "열 개씩 묶음의 수를 먼저 비교해요. 오는 육보다 작아요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "1f2c7f8477f56d9b": {
  "text": "오십육은 육십이보다 작아요. 육십이는 오십육보다 커요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "7f0a1816145d3199": {
  "text": "구십사와 구십일은 열 개씩 묶음의 수가 같아요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "d50ace6a7d5b541b": {
  "text": "그럼 낱개의 수를 비교해요. 사는 일보다 커요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "5837bd9b02ed4fbd": {
  "text": "구십사는 구십일보다 커요. 구십일은 구십사보다 작아요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "32fc99fe11ef3585": {
  "text": "여섯 개와 일곱 개를 둘씩 짝을 지어 볼까요?",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "585bf9b517e1369c": {
  "text": "육은 남는 것이 없어요. 이런 수를 짝수라고 해요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "fab134453144abca": {
  "text": "칠은 하나가 남아요. 이런 수를 홀수라고 해요.",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "1f395e5774699e5a": {
  "text": "이, 사, 육, 팔, 십처럼 둘씩 짝을 지을 때 남는 것이 없는 수는 짝수!",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "eacb37666c4111c0": {
  "text": "일, 삼, 오, 칠, 구처럼 둘씩 짝을 지을 때 하나가 남는 수는 홀수!",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "0cea6cea17285b92": {
  "text": "오늘 배운 개념을 다시 볼까요?",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 },
 "eb4d870a9d1552b4": {
  "text": "스스로 정리 끝! 참 잘했어요!",
  "voice": 22,
  "modeldivision": "KR",
  "type": "ssml"
 }
}